#!/usr/bin/env python3
"""claude-usage - summarise Claude Code token usage from local transcripts.

Two sources live under ~/.claude/projects/**/*.jsonl:

  * assistant turns carry `message.usage` and a timestamp -- these give the
    time-bucketed view (rolling block, today, week, month).
  * `cost-state` records carry Claude Code's own per-session, per-model
    accounting, including background Haiku calls that never reach a
    transcript. These are authoritative for totals but have no per-event
    timestamps.

So: transcripts drive anything time-sliced, cost-state drives all-time totals
and the model breakdown, and `--verify` reconciles the two.

Assistant turns are de-duplicated by (message.id, requestId) because resumed
and forked sessions copy earlier lines into the new transcript.

Subscription rate limits (the rolling session window and the weekly caps
shown by Claude Code's own /usage) are not in the transcripts at all -- they
come from the account endpoint, and are cached on disk between calls.

  claude-usage             JSON for the Plasma widget (default)
  claude-usage --text      pretty terminal report
  claude-usage --daily N   per-day table for the last N days
  claude-usage --limits    plan limits only
  claude-usage --no-limits skip the network call; serve cached limits only
  claude-usage --verify    reconcile computed cost against Claude Code's own
  claude-usage --demo      synthetic JSON (for screenshots and testing);
                           CLAUDE_USAGE_DEMO=1 does the same for the widget
"""
import json, os, re, sys, time, glob
import urllib.error, urllib.request
from collections import defaultdict
from datetime import datetime, timedelta

CLAUDE_DIR = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude"))
BLOCK_HOURS = 5  # Claude subscription limits reset on a rolling 5h window.

# USD per million tokens: (input, output, 5m cache write, 1h cache write, cache read)
# platform.claude.com/docs/en/about-claude/pricing, checked 2026-10-17 and
# reconciled against Claude Code's own recorded costUSD figures (see --verify).
PRICING = {
    "opus-5-5":   (4.0,  20.0,  5.00,  8.0, 0.20),
    "sonnet-5-5": (2.0,  10.0,  2.50,  4.0, 0.10),
    "haiku-5-5":  (0.10,  0.50, 0.125, 0.20, 0.01),
    "fable-5-1":  (10.0, 50.0, 12.50, 20.0, 0.25),
    "mythos-5-1": (10.0, 50.0, 12.50, 20.0, 0.25),
    "fable-5":    (10.0, 50.0, 12.50, 20.0, 1.00),
    "mythos-5":   (10.0, 50.0, 12.50, 20.0, 1.00),
    "opus-5":     (5.0,  25.0,  6.25, 10.0, 0.50),
    "opus-4-8":   (5.0,  25.0,  6.25, 10.0, 0.50),
    "opus-4-7":   (5.0,  25.0,  6.25, 10.0, 0.50),
    "opus-4-6":   (5.0,  25.0,  6.25, 10.0, 0.50),
    "opus-4-5":   (5.0,  25.0,  6.25, 10.0, 0.50),
    "opus-4-1":  (15.0,  75.0, 18.75, 30.0, 1.50),
    "sonnet-5":   (2.0,  10.0,  2.50,  4.0, 0.20),
    "sonnet-4-6": (3.0,  15.0,  3.75,  6.0, 0.30),
    "sonnet-4-5": (3.0,  15.0,  3.75,  6.0, 0.30),
    "haiku-4-5":  (1.0,   5.0,  1.25,  2.0, 0.10),
    "haiku-3-5":  (0.80,  4.0,  1.00,  1.60, 0.08),
}
# Longest key first so "opus-5" can never shadow "opus-5-5".
PRICE_KEYS = sorted(PRICING, key=len, reverse=True)
# Models billed at a higher rate once a single prompt passes a size threshold:
# key -> (prompt tokens, rates above it).
LONG_PROMPT = {
    "haiku-5-5": (100_000, (0.50, 2.50, 0.625, 1.0, 0.05)),
}
WEB_SEARCH_USD = 0.01  # $10 per 1,000 searches


def normalise_model(model):
    """`claude-opus-5[1m]` (the 1M-context variant) and a dated id like
    `claude-haiku-4-5-20251001` are the same model at the same price as their
    base id -- cost-state and transcripts just spell them differently."""
    m = re.sub(r"\[[^\]]*\]$", "", str(model or "unknown"))
    return re.sub(r"-\d{8}$", "", m)


# Model families drive the daily chart. The order is fixed so a family keeps
# its colour in the widget no matter which families appear in a given window.
FAMILIES = ("opus", "sonnet", "haiku", "fable", "other")


def family(model):
    m = (model or "").lower()
    if "fable" in m or "mythos" in m:
        return "fable"
    for f in ("opus", "sonnet", "haiku"):
        if f in m:
            return f
    return "other"


def rate_for(model, prompt_tokens=0):
    """Per-MTok rates for a model; `prompt_tokens` (input + cache writes +
    cache reads of one request) selects a long-prompt tier where one exists."""
    m = (model or "").lower()
    for k in PRICE_KEYS:
        if k in m:
            long = LONG_PROMPT.get(k)
            if long and prompt_tokens > long[0]:
                return long[1]
            return PRICING[k]
    return None


def blank():
    return {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0,
            "thinking": 0, "cost": 0.0, "messages": 0, "web_searches": 0}


def add(dst, src):
    for k in dst:
        dst[k] += src[k]


def parse_ts(ts):
    try:
        return datetime.fromisoformat(str(ts).replace("Z", "+00:00")).astimezone()
    except (ValueError, TypeError):
        return None


def collect():
    """Return (timestamped turns, per-session cost-state records, unpriced
    models, per-session titles)."""
    seen, rows, states, unpriced, titles = set(), [], {}, set(), {}
    for path in glob.glob(os.path.join(CLAUDE_DIR, "projects", "**", "*.jsonl"),
                          recursive=True):
        project = os.path.basename(os.path.dirname(path))
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if ('"usage"' not in line and '"cost-state"' not in line
                        and '"ai-title"' not in line):
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue

                if d.get("type") == "ai-title":
                    # Claude Code retitles as the session goes; keep the latest.
                    if d.get("sessionId") and d.get("aiTitle"):
                        titles[d["sessionId"]] = str(d["aiTitle"])
                    continue

                if d.get("type") == "cost-state":
                    # Records accumulate; the last one per session is the total.
                    d["_project"] = project
                    states[d.get("sessionId")] = d
                    continue

                msg = d.get("message")
                if not isinstance(msg, dict):
                    continue
                u = msg.get("usage")
                if not isinstance(u, dict):
                    continue
                key = (msg.get("id"), d.get("requestId"))
                if key == (None, None) or key in seen:
                    continue
                when = parse_ts(d.get("timestamp"))
                if when is None:
                    continue
                seen.add(key)

                model = normalise_model(msg.get("model"))
                # Cache writes are split by TTL: a 1h write costs 2x base input
                # while a 5m write costs 1.25x, so they must be priced apart.
                cc = u.get("cache_creation") or {}
                w5 = cc.get("ephemeral_5m_input_tokens") or 0
                w1h = cc.get("ephemeral_1h_input_tokens") or 0
                if not (w5 or w1h):
                    w5 = u.get("cache_creation_input_tokens") or 0
                inp = u.get("input_tokens") or 0
                out = u.get("output_tokens") or 0
                read = u.get("cache_read_input_tokens") or 0
                think = (u.get("output_tokens_details") or {}).get("thinking_tokens") or 0
                searches = (u.get("server_tool_use") or {}).get("web_search_requests") or 0

                r = rate_for(model, inp + w5 + w1h + read)
                if r:
                    pin, pout, p5, p1h, pread = r
                    cost = (inp * pin + out * pout + w5 * p5 + w1h * p1h
                            + read * pread) / 1e6 + searches * WEB_SEARCH_USD
                else:
                    cost = 0.0
                    if model not in ("<synthetic>", "unknown"):
                        unpriced.add(model)

                rows.append({
                    "t": when, "model": model, "project": project,
                    "cwd": d.get("cwd"),
                    "session": d.get("sessionId") or d.get("session_id"),
                    "u": {"input": inp, "output": out, "cache_write": w5 + w1h,
                          "cache_read": read, "thinking": think, "cost": cost,
                          "messages": 1, "web_searches": searches},
                })
    rows.sort(key=lambda r: r["t"])
    return rows, states, sorted(unpriced), titles

# ------------------------------------------------------------- plan limits
# Subscription limits come from the same endpoint Claude Code's own /usage
# reads. The OAuth access token is minted and refreshed by Claude Code; we
# only read it, and only ever send it back to the host that issued it. On a
# 401 we keep serving cached figures rather than touching the refresh token --
# rotating it here would log Claude Code out.
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CRED_FILE = os.path.join(CLAUDE_DIR, ".credentials.json")
CACHE_DIR = os.path.join(os.path.expanduser(
    os.environ.get("XDG_CACHE_HOME", "~/.cache")), "claude-usage")
LIMITS_CACHE = os.path.join(CACHE_DIR, "limits.json")
# The widget polls once a minute; the limits move slowly, so serve most of
# those from disk.
LIMITS_TTL = int(os.environ.get("CLAUDE_USAGE_LIMITS_TTL") or 120)

LIMIT_LABELS = {"session": "Session", "weekly_all": "Week",
                "weekly_scoped": "Week"}
# Window lengths, so the widget can mark how far through each window we are.
WINDOW_MIN = {"session": BLOCK_HOURS * 60, "weekly_all": 7 * 1440,
              "weekly_scoped": 7 * 1440}
# Older/alternate response shape: one object per limit rather than a list.
NAMED_LIMITS = [
    ("five_hour", "session", "Session"),
    ("seven_day", "weekly_all", "Week"),
    ("seven_day_opus", "weekly_scoped", "Week (Opus)"),
    ("seven_day_sonnet", "weekly_scoped", "Week (Sonnet)"),
    ("seven_day_overage_included", "weekly_scoped", "Week (Fable)"),
]


def credentials():
    try:
        with open(CRED_FILE, encoding="utf-8") as fh:
            return json.load(fh).get("claudeAiOauth") or {}
    except (OSError, ValueError):
        return {}


def plan_label():
    c = credentials()
    parts = []
    sub = str(c.get("subscriptionType") or "").strip()
    if sub:
        parts.append(sub.title())
    m = re.search(r"max_(\d+)x", str(c.get("rateLimitTier") or ""))
    if m:
        parts.append("Max " + m.group(1) + "x")
    return " · ".join(parts) or None


def read_limit_cache():
    try:
        with open(LIMITS_CACHE, encoding="utf-8") as fh:
            c = json.load(fh)
        if isinstance(c.get("raw"), dict) and isinstance(c.get("at"), (int, float)):
            return c
    except (OSError, ValueError, AttributeError):
        pass
    return None


def write_limit_cache(raw):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = LIMITS_CACHE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump({"at": time.time(), "raw": raw}, fh)
        os.replace(tmp, LIMITS_CACHE)
    except OSError:
        pass


def fetch_limits(offline=False, force=False):
    cache = read_limit_cache()
    if cache and not force and time.time() - cache["at"] < LIMITS_TTL:
        return shape_limits(cache["raw"], cache["at"], fresh=True)
    if offline:
        return (shape_limits(cache["raw"], cache["at"], fresh=False) if cache
                else {"ok": False, "reason": "not fetched", "entries": [],
                      "plan": plan_label()})

    token = credentials().get("accessToken")
    if not token:
        return {"ok": False, "reason": "not signed in to claude.ai",
                "entries": [], "plan": plan_label()}

    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + token,
        "Content-Type": "application/json",
        "anthropic-beta": "oauth-2025-04-20",
        "User-Agent": "claude-usage",
    })
    try:
        with urllib.request.urlopen(req, timeout=6) as resp:
            raw = json.loads(resp.read().decode("utf-8"))
        if not isinstance(raw, dict):
            raise ValueError("unexpected response")
    except Exception as e:
        if isinstance(e, urllib.error.HTTPError) and e.code == 401:
            reason = "token expired; refreshes on next Claude Code request"
        elif isinstance(e, urllib.error.HTTPError):
            reason = "HTTP %s" % e.code
        else:
            reason = str(e) or e.__class__.__name__
        if cache:  # better a stale number than none
            out = shape_limits(cache["raw"], cache["at"], fresh=False)
            out["reason"] = reason
            return out
        return {"ok": False, "reason": reason, "entries": [],
                "plan": plan_label()}

    write_limit_cache(raw)
    return shape_limits(raw, time.time(), fresh=True)


def shape_limits(raw, at, fresh):
    """Flatten the endpoint's response into rows the widget can draw."""
    entries, now = [], datetime.now().astimezone()

    def push(kind, label, pct, resets_at, severity=None, active=None):
        if pct is None:
            return
        try:
            pct = float(pct)
        except (TypeError, ValueError):
            return
        when = parse_ts(resets_at)
        entries.append({
            "kind": kind, "label": label, "pct": round(pct, 1),
            "resets_at": resets_at,
            "resets_at_local": when.strftime("%H:%M") if when else None,
            "resets_day": when.strftime("%a") if when else None,
            "resets_in_min": max(0, int((when - now).total_seconds() // 60))
                             if when else None,
            "severity": severity or ("critical" if pct >= 95 else
                                     "warning" if pct >= 80 else "normal"),
            "window_min": WINDOW_MIN.get(kind),
            "active": bool(active) if active is not None else None,
        })

    rows = raw.get("limits")
    if isinstance(rows, list) and rows:
        for lim in rows:
            if not isinstance(lim, dict):
                continue
            kind = lim.get("kind") or "other"
            label = LIMIT_LABELS.get(kind) or kind.replace("_", " ").capitalize()
            model = ((lim.get("scope") or {}).get("model") or {}).get("display_name")
            if model:
                label = "%s (%s)" % (label, model)
            push(kind, label, lim.get("percent"), lim.get("resets_at"),
                 lim.get("severity"), lim.get("is_active"))
    else:
        for key, kind, label in NAMED_LIMITS:
            v = raw.get(key)
            if isinstance(v, dict):
                push(kind, label, v.get("utilization"), v.get("resets_at"))

    rank = {"session": 0, "weekly_all": 1}
    entries.sort(key=lambda e: (rank.get(e["kind"], 2), -e["pct"]))

    # Usage credits, when the account has them switched on.
    credits = None
    spend = raw.get("spend")
    if isinstance(spend, dict) and spend.get("enabled"):
        def money(m):
            if not isinstance(m, dict) or m.get("amount_minor") is None:
                return None
            return m["amount_minor"] / (10 ** (m.get("exponent") or 0))
        used = spend.get("used") if isinstance(spend.get("used"), dict) else {}
        credits = {"currency": used.get("currency") or "USD",
                   "used": money(used) or 0.0,
                   "limit": money(spend.get("limit")),
                   "pct": spend.get("percent")}

    return {
        "ok": True, "fresh": bool(fresh), "stale": not fresh,
        "fetched": datetime.fromtimestamp(at).astimezone().isoformat(),
        "age_sec": int(max(0, time.time() - at)),
        "plan": plan_label(), "entries": entries, "credits": credits,
    }


def block_bounds(rows, now):
    """The active window starts at the top of the hour of its first request."""
    start = None
    for r in rows:
        if start is None or r["t"] >= start + timedelta(hours=BLOCK_HOURS):
            start = r["t"].replace(minute=0, second=0, microsecond=0)
    if start is None or now >= start + timedelta(hours=BLOCK_HOURS):
        return None, None
    return start, start + timedelta(hours=BLOCK_HOURS)


def summarise(limits=True):
    rows, states, unpriced, titles = collect()
    now = datetime.now().astimezone()
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)

    buckets = {k: blank() for k in ("today", "week", "month", "total")}
    by_day, by_session, tx_models = (defaultdict(blank), defaultdict(blank),
                                     defaultdict(blank))
    last_seen, session_project, session_cwd, session_model = {}, {}, {}, {}
    day_family = defaultdict(lambda: defaultdict(float))

    for r in rows:
        u = r["u"]
        add(buckets["total"], u)
        add(tx_models[r["model"]], u)
        add(by_day[r["t"].strftime("%Y-%m-%d")], u)
        day_family[r["t"].strftime("%Y-%m-%d")][family(r["model"])] += u["cost"]
        if r["session"]:
            add(by_session[r["session"]], u)
            last_seen[r["session"]] = r["t"]
            session_project[r["session"]] = r["project"]
            if r.get("cwd"):
                session_cwd[r["session"]] = r["cwd"]
            if r["model"] not in ("<synthetic>", "unknown"):
                session_model[r["session"]] = r["model"]
        if r["t"] >= midnight:
            add(buckets["today"], u)
        if r["t"] >= now - timedelta(days=7):
            add(buckets["week"], u)
        if r["t"] >= now - timedelta(days=30):
            add(buckets["month"], u)

    # --- rolling block
    start, end = block_bounds(rows, now)
    btot = blank()
    if start:
        for r in rows:
            if r["t"] >= start:
                add(btot, r["u"])
        elapsed_min = max(1.0, (now - start).total_seconds() / 60)
        remaining_min = max(0, int((end - now).total_seconds() // 60))
        time_pct = min(100.0, elapsed_min / (BLOCK_HOURS * 60) * 100)
        burn_cost_hr = btot["cost"] / (elapsed_min / 60)
        block = {
            "active": True,
            "start": start.isoformat(), "end": end.isoformat(),
            "remaining_min": remaining_min,
            "time_pct": round(time_pct, 1),
            "burn_tokens_per_min": round(tokens_of(btot) / elapsed_min),
            "burn_cost_per_hour": round(burn_cost_hr, 4),
            "projected_cost": round(btot["cost"] + burn_cost_hr * remaining_min / 60, 4),
        }
    else:
        block = {"active": False, "start": None, "end": None, "remaining_min": 0,
                 "time_pct": 0.0, "burn_tokens_per_min": 0,
                 "burn_cost_per_hour": 0.0, "projected_cost": 0.0}
    block.update(pack(btot))

    # --- models & all-time total: cost-state is authoritative where present,
    # since background Haiku calls never appear as transcript turns.
    models, counted = defaultdict(blank), set()
    for sid, st in states.items():
        counted.add(sid)
        for name, m in (st.get("modelUsage") or {}).items():
            add(models[normalise_model(name)], {
                "input": m.get("inputTokens", 0), "output": m.get("outputTokens", 0),
                "cache_write": m.get("cacheCreationInputTokens", 0),
                "cache_read": m.get("cacheReadInputTokens", 0),
                "thinking": m.get("thinkingTokens", 0),
                "cost": m.get("costUSD", 0.0), "messages": 0,
                "web_searches": m.get("webSearchRequests", 0)})
    for r in rows:  # sessions Claude Code has not written a cost-state for yet
        if r["session"] not in counted:
            add(models[r["model"]], r["u"])

    authoritative = blank()
    for v in models.values():
        add(authoritative, v)
    authoritative["messages"] = buckets["total"]["messages"]
    if authoritative["cost"] > buckets["total"]["cost"]:
        buckets["total"] = authoritative

    # --- recent sessions
    sessions = []
    for sid, t in sorted(last_seen.items(), key=lambda kv: kv[1], reverse=True)[:8]:
        st = states.get(sid)
        cost = st["totalCostUSD"] if st and st.get("totalCostUSD") else by_session[sid]["cost"]
        cwd = session_cwd.get(sid)
        sessions.append({
            "id": sid, "project": session_project.get(sid, "?"),
            "title": titles.get(sid),
            "cwd": cwd,
            "dir": (os.path.basename(cwd.rstrip("/")) or "/") if cwd else None,
            "model": session_model.get(sid),
            "cost": round(cost, 4), "tokens": tokens_of(by_session[sid]),
            "last": t.isoformat(),
            "ago_min": int(max(0, (now - t).total_seconds()) // 60),
            "active": bool(start and t >= start),
        })

    # --- last 14 days, split by model family, oldest first
    daily = []
    for i in range(13, -1, -1):
        d = (midnight - timedelta(days=i))
        key = d.strftime("%Y-%m-%d")
        fam = {f: round(day_family[key].get(f, 0.0), 4) for f in FAMILIES}
        daily.append({"date": key, "label": d.strftime("%-d %b"),
                      "weekday": d.strftime("%a"), "cost": round(sum(fam.values()), 4),
                      "families": fam})

    return {
        "generated": now.isoformat(),
        "block_hours": BLOCK_HOURS,
        "limits": fetch_limits(offline=not limits),
        "block": block,
        "today": pack(buckets["today"]), "week": pack(buckets["week"]),
        "month": pack(buckets["month"]), "total": pack(buckets["total"]),
        "models": {k: pack(v) for k, v in
                   sorted(models.items(), key=lambda kv: -kv[1]["cost"])},
        "sessions": sessions,
        "by_day": {k: pack(by_day[k]) for k in sorted(by_day, reverse=True)},
        "daily": daily,
        "families": list(FAMILIES),
        "session_count": len(set(last_seen) | set(states)),
        "first_seen": rows[0]["t"].isoformat() if rows else None,
        "unpriced_models": unpriced,
    }


def tokens_of(u):
    return u["input"] + u["output"] + u["cache_write"] + u["cache_read"]


def pack(u):
    d = dict(u)
    d["tokens"] = tokens_of(u)
    d["cost"] = round(u["cost"], 4)
    return d


def human(n):
    for lim, suf in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= lim:
            return f"{n / lim:.2f}".rstrip("0").rstrip(".") + suf
    return str(int(n))


def verify():
    """Recompute every cost-state entry from its own token counts."""
    _, states, _, _ = collect()
    rec_tot = calc_tot = 0.0
    bad = 0
    print("\n\033[1mReconciliation against Claude Code's recorded costs\033[0m\n")
    for st in states.values():
        for name, m in (st.get("modelUsage") or {}).items():
            r = rate_for(name)
            if not r:
                print(f"  \033[33mno price data\033[0m  {name}")
                continue
            pin, pout, p5, p1h, pread = r
            # cost-state does not split cache writes by TTL, so the true cost
            # lies between "all 5m writes" and "all 1h writes".
            base = (m["inputTokens"] * pin + m["outputTokens"] * pout
                    + m["cacheReadInputTokens"] * pread) / 1e6
            base += m.get("webSearchRequests", 0) * WEB_SEARCH_USD
            lo = base + m["cacheCreationInputTokens"] * p5 / 1e6
            calc = base + m["cacheCreationInputTokens"] * p1h / 1e6
            rec = m.get("costUSD", 0.0)
            rec_tot += rec
            calc_tot += calc
            tol = max(0.005, rec * 0.01)
            exact = abs(calc - rec) < tol
            mixed = not exact and lo - tol <= rec <= calc + tol
            ok = exact or mixed
            bad += not ok
            tag = ('\033[32mok  \033[0m' if exact else
                   '\033[32mmix \033[0m' if mixed else '\033[31mDIFF\033[0m')
            print(f"  {tag} {name:<28} recorded ${rec:>9.4f}  computed ${calc:>9.4f}"
                  + (f"  \033[2m(5m-1h range ${lo:,.2f}-${calc:,.2f})\033[0m" if mixed else ""))
    delta = calc_tot - rec_tot
    print(f"\n  total recorded ${rec_tot:,.4f}   computed (1h writes) ${calc_tot:,.4f}"
          f"   delta ${delta:+.4f}")
    print("  \033[2mmix = recorded cost sits between the all-5m and all-1h cache-write"
          " prices, i.e. the session used both TTLs\033[0m")
    print(f"  \033[{'32m' if not bad else '31m'}{'all entries match' if not bad else str(bad) + ' mismatched'}\033[0m\n")
    return 1 if bad else 0


def bar(pct, width=22):
    filled = int(round(min(100.0, max(0.0, pct)) / 100 * width))
    return "\u2588" * filled + "\u2591" * (width - filled)


def until(mins):
    if mins is None:
        return ""
    h, m = divmod(mins, 60)
    if h >= 24:
        d, h = divmod(h, 24)
        return f"{d}d {h}h"
    return f"{h}h {m:02d}m" if h else f"{m}m"


def limits_report(lim, indent="  "):
    B, D, R = "\033[1m", "\033[2m", "\033[0m"
    if not lim or not lim.get("ok"):
        why = (lim or {}).get("reason") or "unavailable"
        print(f"{indent}{D}plan limits unavailable - {why}{R}")
        return
    for e in lim["entries"]:
        colour = ("\033[31m" if e["severity"] == "critical"
                  else "\033[33m" if e["severity"] == "warning" else "\033[32m")
        when = ""
        if e["resets_in_min"] is not None:
            when = (f"resets in {until(e['resets_in_min'])} "
                    f"(at {e['resets_at_local']}"
                    + (f" {e['resets_day']}" if e["resets_in_min"] >= 720 else "") + ")")
        print(f"{indent}{e['label']:<18} {colour}{bar(e['pct'])}{R} "
              f"{e['pct']:>5.1f}%  {D}{when}{R}")
    c = lim.get("credits")
    if c and (c["limit"] or c["used"]):
        cap = f" of {c['currency']} {c['limit']:,.2f}" if c["limit"] else ""
        print(f"{indent}{D}usage credits {c['currency']} {c['used']:,.2f}{cap}{R}")
    if lim.get("stale"):
        print(f"{indent}{D}(cached {until(lim['age_sec'] // 60) or 'just now'} ago"
              f"{' - ' + lim['reason'] if lim.get('reason') else ''}){R}")


def report(s, daily_days=0):
    B, D, R = "\033[1m", "\033[2m", "\033[0m"

    def line(label, b):
        print(f"  {label:<10} {human(b['tokens']):>8}  ${b['cost']:>9,.2f}"
              f"  {D}{b['messages']:>5} msg{R}")

    lim = s.get("limits") or {}
    print(f"\n{B}Claude Code usage{R}  {D}{s['session_count']} sessions"
          f"{', since ' + s['first_seen'][:10] if s['first_seen'] else ''}{R}\n")

    print(f"{B}Plan limits{R}{D}{'  ' + lim['plan'] if lim.get('plan') else ''}{R}")
    limits_report(lim)
    print()
    for k, lbl in (("today", "Today"), ("week", "Last 7d"),
                   ("month", "Last 30d"), ("total", "All time")):
        line(lbl, s[k])

    b = s["block"]
    print(f"\n{B}Rolling {s['block_hours']}h block{R}")
    if b["active"]:
        h, m = divmod(b["remaining_min"], 60)
        print(f"  {human(b['tokens']):>8}  ${b['cost']:,.2f}   "
              f"{D}{b['time_pct']:.0f}% elapsed, resets in {h}h {m:02d}m "
              f"(at {b['end'][11:16]}){R}")
        print(f"  {D}burn ${b['burn_cost_per_hour']:,.2f}/h · "
              f"{human(b['burn_tokens_per_min'])} tok/min · "
              f"projected ${b['projected_cost']:,.2f} by close{R}")
    else:
        print(f"  {D}idle - no requests in the last {s['block_hours']} hours{R}")

    print(f"\n{B}By model{R}")
    for m, v in s["models"].items():
        print(f"  {m:<26} {human(v['tokens']):>8}  ${v['cost']:>9,.2f}")

    print(f"\n{B}Recent sessions{R}")
    for ss in s["sessions"][:5]:
        dot = "\033[32m*\033[0m" if ss["active"] else f"{D}-{R}"
        proj = ss["project"].replace("-", "/", 1).replace("-", "/")
        print(f"  {dot} {proj[:34]:<34} {human(ss['tokens']):>8}  ${ss['cost']:>8,.2f}")

    if daily_days:
        print(f"\n{B}Daily{R}")
        for day in list(s["by_day"])[:daily_days]:
            v = s["by_day"][day]
            print(f"  {day}  {human(v['tokens']):>8}  ${v['cost']:>8,.2f}"
                  f"  {D}{v['messages']:>4} msg{R}")

    t = s["total"]
    if t["tokens"]:
        print(f"\n{D}  cache reads {t['cache_read'] / t['tokens'] * 100:.0f}% of all "
              f"tokens · output {human(t['output'])} "
              f"({human(t['thinking'])} thinking){R}")
    if s["unpriced_models"]:
        print(f"{D}  counted but not costed: {', '.join(s['unpriced_models'])}{R}")
    print()


def demo():
    """Plausible synthetic output, so screenshots never leak real projects."""
    now = datetime.now().astimezone()
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)

    def at(mins):
        return (now + timedelta(minutes=mins)).isoformat()

    def lim(kind, label, pct, mins):
        when = now + timedelta(minutes=mins)
        return {"kind": kind, "label": label, "pct": pct, "resets_at": when.isoformat(),
                "resets_at_local": when.strftime("%H:%M"), "resets_day": when.strftime("%a"),
                "resets_in_min": mins, "window_min": WINDOW_MIN[kind],
                "severity": "critical" if pct >= 95 else "warning" if pct >= 80 else "normal",
                "active": kind == "session"}

    def u(cost, tokens, msgs=0):
        return {"input": tokens // 400, "output": tokens // 60, "cache_write": tokens // 25,
                "cache_read": tokens - tokens // 400 - tokens // 60 - tokens // 25,
                "thinking": tokens // 200, "cost": cost, "messages": msgs,
                "web_searches": 0, "tokens": tokens}

    pattern = [(3.1, 0.4, 0.05), (0, 0, 0), (8.6, 1.2, 0.1), (12.4, 0.0, 0.2), (6.2, 2.1, 0.1),
               (0.0, 0.0, 0.0), (4.4, 0.0, 0.1), (15.8, 0.9, 0.2), (9.7, 0.0, 0.1), (11.2, 3.4, 0.2),
               (2.3, 0.0, 0.0), (7.9, 0.6, 0.1), (13.5, 1.1, 0.2), (10.4, 0.8, 0.1)]
    daily = []
    for i, (o, s_, h) in enumerate(pattern):
        d = midnight - timedelta(days=13 - i)
        fam = {"opus": o, "sonnet": s_, "haiku": h, "fable": 0.0, "other": 0.0}
        daily.append({"date": d.strftime("%Y-%m-%d"), "label": d.strftime("%-d %b"),
                      "weekday": d.strftime("%a"), "cost": round(sum(fam.values()), 4),
                      "families": fam})
    today, week = daily[-1]["cost"], sum(x["cost"] for x in daily[-7:])
    sessions = [
        ("Refactor the storage layer", "orbit-api", "claude-opus-5-5", 4.82, 3, True),
        ("Fix flaky websocket tests", "orbit-web", "claude-opus-5-5", 2.37, 18, True),
        ("Write release notes for 2.4", "orbit-docs", "claude-sonnet-5-5", 0.64, 95, False),
        ("Profile the image pipeline", "lumen", "claude-opus-5-5", 3.91, 260, False),
        ("Add CSV export to reports", "ledger", "claude-sonnet-5-5", 1.12, 1440, False),
    ]
    return {
        "generated": now.isoformat(), "block_hours": BLOCK_HOURS,
        "limits": {"ok": True, "fresh": True, "stale": False, "fetched": now.isoformat(),
                   "age_sec": 12, "plan": "Max · Max 5x", "credits": None,
                   "entries": [lim("session", "Session", 46.0, 128),
                               lim("weekly_all", "Week", 58.0, 2 * 1440 + 310),
                               lim("weekly_scoped", "Week (Sonnet)", 21.0, 2 * 1440 + 310)]},
        "block": dict(u(7.86, 9_400_000, 61), active=True, start=at(-172), end=at(128),
                      remaining_min=128, time_pct=57.3, burn_tokens_per_min=54_600,
                      burn_cost_per_hour=2.74, projected_cost=13.71),
        "today": u(today, 14_100_000, 112), "week": u(week, 71_500_000, 640),
        "month": u(week * 3.6, 251_000_000, 2210), "total": u(week * 5.1, 352_000_000, 3105),
        "models": {"claude-opus-5-5": u(week * 4.4, 300_000_000), "claude-sonnet-5-5": u(week * 0.55, 41_000_000),
                   "claude-haiku-5-5": u(week * 0.15, 11_000_000)},
        "sessions": [{"id": "demo-%d" % i, "project": "-demo-" + d, "title": t,
                      "cwd": "/home/you/code/" + d, "dir": d, "model": m, "cost": c,
                      "tokens": int(c * 1_300_000), "last": at(-a), "ago_min": a, "active": act}
                     for i, (t, d, m, c, a, act) in enumerate(sessions)],
        "by_day": {}, "daily": daily, "families": list(FAMILIES),
        "session_count": 87, "first_seen": (now - timedelta(days=40)).isoformat(),
        "unpriced_models": [],
    }


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--demo" in args or os.environ.get("CLAUDE_USAGE_DEMO") == "1":
        if "--text" in args or "--daily" in args:
            report(demo(), daily_days=14 if "--daily" in args else 0)
        else:
            print(json.dumps(demo(), separators=(",", ":")))
        sys.exit(0)
    if "--verify" in args:
        sys.exit(verify())
    if "--limits" in args:
        lim = fetch_limits(offline="--no-limits" in args, force="--force" in args)
        if "--json" in args:
            print(json.dumps(lim, separators=(",", ":")))
        else:
            print(f"\n\033[1mPlan limits\033[0m\033[2m"
                  f"{'  ' + lim['plan'] if lim.get('plan') else ''}\033[0m")
            limits_report(lim)
            print()
        sys.exit(0)
    try:
        s = summarise(limits="--no-limits" not in args)
    except Exception as e:  # the widget must always get parseable JSON
        if "--text" not in args and "--daily" not in args:
            print(json.dumps({"error": str(e)}))
            sys.exit(0)
        raise
    if "--text" in args or "--daily" in args:
        n = 0
        if "--daily" in args:
            i = args.index("--daily")
            n = int(args[i + 1]) if len(args) > i + 1 and args[i + 1].isdigit() else 14
        report(s, daily_days=n)
    else:
        print(json.dumps(s, separators=(",", ":")))
